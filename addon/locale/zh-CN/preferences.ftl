pref-title = 通用
pref-enable-autoTranslate =
    .label = 是否启用自动翻译
pref-enable-compatibility =
    .label = 启用兼容模式
pref-enable-compatibility-description = 启用后将会改善 PDF 兼容性，但是会增大输出文件大小
pref-enable-autoExtractGlossary =
    .label = 自动提取术语
pref-enable-autoExtractGlossary-description = 可以提升专有名词翻译一致性，但会让 Token 消耗量翻倍
pref-enable-richTextTranslate =
    .label = 富文本翻译
pref-enable-ocr-workaround = 启用 OCR 临时解决方案
pref-enable-ocr-workaround-description = 当您的扫描/图片版 PDF 文件已进行 OCR 处理，且为白底黑字时，可以尝试启用 OCR 版的临时解决方案。该方案将在译文下方添加白色矩形块，以覆盖原文内容。
pref-authkey = 输入授权码
pref-customSystemPrompt = 自定义角色提示词
pref-translate-model = PDF 翻译模型
pref-translate-mode = PDF 翻译模式
pref-target-language = 目标语言
pref-selectionTranslationDeepSeekApiKey = 划词翻译 DeepSeek API Key
pref-selectionTranslationDeepSeekApiKey-description = 用于 PDF Reader 划词和批注翻译，包括你主动开启的自动选项。保存在本地 Zotero 偏好设置/配置目录中；建议使用可撤销、额度受限的 Key。它与沉浸式翻译授权码分开保存。
pref-selectionTranslationModel = 划词翻译模型
pref-selectionTranslationModel-description = 留空时默认使用 deepseek-v4-flash。本 MVP 不使用 deepseek-reasoner。
pref-selectionTranslationThinkingMode = 划词翻译思考模式
pref-selectionTranslationThinkingMode-description = 关闭会保持更快的无思考行为。高和最高会为划词翻译启用 DeepSeek 思考模式。
pref-selectionTranslationAutoTranslateText =
    .label = 自动翻译 PDF 划词文本
pref-selectionTranslationAutoTranslateText-description = 开启后，选中 PDF 文本会自动开始划词翻译。最终方案应在你用同一选区创建批注时复用这次译文，避免重复请求 DeepSeek。
pref-selectionTranslationAutoWriteAnnotationComment =
    .label = 自动将批注翻译写入评论
pref-selectionTranslationAutoWriteAnnotationComment-description = 默认开启。启用后，通过批注按钮或右键菜单触发的批注翻译成功时，会保存到当前批注评论的插件标记块中。关闭后，需要在条目侧栏中手动更新评论。
pref-selectionTranslationAutoTranslateNewAnnotations =
    .label = 创建 PDF 批注后翻译并写入评论
pref-selectionTranslationAutoTranslateNewAnnotations-description = 默认开启。当你从最近的 Reader 原文选区创建 PDF 批注或高亮时，插件会翻译一次并把结果写入该批注评论。已有译文标记的批注会被跳过。
pref-font-family = 字体
pref-dual-mode = 双语对照显示方式
pref-layout-model = 布局识别模型
pref-test-button = 测试
pref-enable-autoOpenPDF =
    .label = 自动打开翻译后的 PDF
pref-enable-autoTranslate-description = 启用后将会自动翻译新添加的 PDF 文件，无法解析为条目的 PDF 文件暂不支持自动翻译
pref-shortcuts-settings = 快捷键
pref-enable-shortcuts =
    .label = 启用快捷键
pref-shortcuts-description = 默认快捷键在 Windows/Linux 使用 Ctrl，在 macOS 使用 Cmd。清空某一项只会停用该动作。
pref-shortcut-translate = 翻译所选条目快捷键
pref-shortcut-task-manager = 打开翻译任务管理器快捷键
pref-shortcut-reset =
    .label = 恢复默认
pref-shortcut-duplicate-error = 该快捷键已被另一个插件动作使用。插件快捷键不能重复。
pref-shortcut-conflict-guidance = 自定义快捷键可能与 Zotero 或系统快捷键冲突。除 Zotero 条目列表原生使用的 Shift+字母 外，插件不会因此阻止保存。

pref-imt-site = 在沉浸式翻译官网个人主页获取授权码

pref-translate-settings = 翻译

pref-translate-settings-advance = 高级选项

pref-about = 关于

pref-about-feedback =
    .value = GitHub
pref-about-docs =
    .value = 文档
pref-about-version =
    .value = { $name } 版本 { $version } Build { $time }
